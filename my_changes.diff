+  border-right: none;
+}
+.pipeline-tab:hover {
+  background: rgba(0,0,0,0.02);
+  color: #111827;
+}
+.pipeline-tab.active {
+  color: #0868de;
+  background: rgba(8, 104, 222, 0.05);
+}
